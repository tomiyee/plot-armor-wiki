PORT=3001

# Which database `npm run dev` connects to: "prod" (DATABASE_URL) or "dev" (DEV_DATABASE_URL).
# Unset defaults to "prod" so deployments that only set DATABASE_URL keep working.
# Override per run with `npm run dev:prod` / `npm run dev:dev`.
DB_ENV=dev

# Production PostgreSQL connection string (also the only one deployments need)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Dev PostgreSQL connection string (local Docker). Also used by scripts/*-db.sh|ps1.
DEV_DATABASE_URL=postgresql://postgres:dev@localhost:5432/plotarmor
